# ~/.config/sync-repos/orgs.conf
#
# One organization (or user) a line:
#
#   LOCAL_DIR=ORG              every repository of ORG, under ~/GithubOrgs/LOCAL_DIR
#   LOCAL_DIR=ORG:repo1,repo2  only these repositories; no listing is made
#
# Blank lines and lines starting with # are skipped.
# An item REPO>DIR gives a checkout its own directory name, for example:
#   mine=someone:dotfiles>dots,notes
#
# Entries before any header use token beside this file. A [NAME] header
# uses tokens/NAME instead; [default] goes back to the first identity:
#   [work]
#   lab=some-org
# Token files must have mode 600; the tokens directory mode 700.
# Over SSH, [work] clones through the host alias github-work.

wolffe-lang=wolffe-lang
