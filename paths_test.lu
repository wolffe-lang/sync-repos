//! member: false
//! Path decisions, without touching the environment.

use conf
use paths

fn test_defaults_hang_off_home() {
	let p = paths.resolve("/home/you", "", "") else { assert(false, "refused"); return }
	assert(p.config == "/home/you/.config/sync-repos/orgs.conf", p.config)
	assert(p.root == "/home/you/GithubOrgs", p.root)
	assert(p.token == "/home/you/.config/sync-repos/token", p.token)
}

fn test_the_token_sits_beside_the_config() {
	let p = paths.resolve("/home/you", "/etc/sync/orgs.conf", "") else {
		assert(false, "refused")
		return
	}

	assert(p.token == "/etc/sync/token", p.token)
}

fn test_each_override_wins_alone() {
	let p = paths.resolve("/home/you", "/etc/orgs.conf", "") else {
		assert(false, "refused")
		return
	}

	assert(p.config == "/etc/orgs.conf", p.config)
	assert(p.root == "/home/you/GithubOrgs", p.root)
}

fn test_no_home_is_fine_when_nothing_needs_it() {
    let p = paths.resolve("", "/etc/orgs.conf", "/srv/orgs") else {
        assert(false, "refused")
        return
    }
    assert(p.root == "/srv/orgs", p.root)
}

fn test_no_home_is_refused_when_something_needs_it() {
    let p = paths.resolve("", "/etc/orgs.conf", "") else { return }
    assert(false, "accepted, with root {p.root}")
}

fn test_a_named_identity_has_a_file_of_its_own() {
    let p = paths.resolve("/home/you", "", "") else { assert(false, "refused"); return }
    assert(
        paths.token_file(p, conf.DEFAULT) == "/home/you/.config/sync-repos/token",
        paths.token_file(p, conf.DEFAULT),
    )
    assert(
        paths.token_file(p, "work") == "/home/you/.config/sync-repos/tokens/work",
        paths.token_file(p, "work"),
    )
}

fn test_the_tokens_directory_follows_the_config_too() {
    let p = paths.resolve("", "/etc/sync/orgs.conf", "/srv/orgs") else {
        assert(false, "refused")
        return
    }
    assert(paths.token_file(p, "work") == "/etc/sync/tokens/work", paths.token_file(p, "work"))
}