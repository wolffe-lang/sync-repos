//! One repository's directory on disk: what state it is in, and how to
//! bring it up to date

use git
use std.fs

/// what is at a repository's path before anything is done to it.
pub enum State {
	/// Nothing is there.
	Absent,
	/// An empty directory: safe to remove and clone into.
	Empty,
	/// A directory with files in it that is not a git checkout.
	Foreign,
	/// It has a `.git` but git cannot read a commit from it.
	Broken,
	/// A checkout with staged or unstaged changes.
	Dirty,
	/// A checkout with nothing to lose.
	Clean,
}

/// What a fast-forward pull did.
pub enum Pulled {
	/// The checkout already had everything.
	UpToDate,
	/// New commits arrived.
	Updated,
	/// The branch and its upstream have each moved, or there is no
	/// upstream: nothing was changed.
	Refused,
}

/// How a clone ended.
pub enum Cloned {
	/// A full clone.
	Full,
	/// A clone with history cut to the newest commit.
	Shallow,
	/// Every attempt failed or ran out of time. Nothing is left behind.
	GaveUp,
}

/// How long a quick local git command may take.
const QUICK_MS: int = 600000

/// Look at `path` and say which state it is in. Reads only.
pub fn inspect(path: str) -> State ! git.Failure {
	if !fs.exists(path) { return State.Absent }
	if !fs.exists("{path}/.git") {
		let names = fs.read_dir(path) else |_| { return State.Foreign }
		return if names.len == 0 { State.Empty } else { State.Foreign }
	}

	let head = git.run(path, ["rev-parse", "HEAD"], QUICK_MS)?	
	if head.code != 0 { return State.Broken }

	let unstaged = git.run(path, ["diff", "--quiet"], QUICK_MS)?
	let staged = git.run(path, ["diff", "--cached", "--quiet"], QUICK_MS)?
	if unstaged.code != 0 || staged.code != 0 { return State.Dirty }

	State.Clean
}

/// Fast-forward a clean checkout. Never merges and never rewrites.
pub fn pull(path: str, limit_ms: int) -> Pulled ! git.Failure {
	let before = git.run(path, ["rev-parse", "HEAD"], QUICK_MS)?
	let pulled = git.run(path, ["pull", "--ff-only"], limit_ms)?

	if pulled.code != 0 { return Pulled.Refused }

	let after = git.run(path, ["rev-parse", "HEAD"], QUICK_MS)?

	if before.out == after.out { Pulled.UpToDate } else { Pulled.Updated }
}

/// The arguments for clone attempt `attempt` of `of`: a full clone, and a 
/// shallow one on the last attempt.
pub fn clone_args(url: str, name: str, attempt: int, of: int) -> List[str] {
	var args = ["clone", "--quiet"]

	if attempt == of && of > 1 {
		(mut args).push("--depth")
		(mut args).push("1")
	}

	(mut args).push(url)
	(mut args).push(name)

	args
}

/// Clone `url` into `parent/name`, trying up to `tries` times. A failed
/// attempt's leftovers are removed before the next. A time limit reached
/// counts as a failed attempt, not as a failure of the whole clone.
pub fn clone(url: str, parent: str, name: str, tries: int, limit_ms: int) -> Cloned ! git.Failure {
	let path = "{parent}/{name}"

	var attempt = 1
	while attempt <= tries {
		if fs.exists(path) { fs.remove_dir_all(path) else |_| { return io } }
		let ran = git.run(
			parent,
			clone_args(url, name, attempt, tries),
			limit_ms,
		) else |e| match e {
			not_found => { return not_found },
			timeout => { git.Ran { code: 124, out: "" } },
			io => { return io },
		}

		if ran.code == 0 && fs.exists("{path}/.git") {
			return if attempt == tries && tries > 1 { Cloned.Shallow } else { Cloned.Full }
		}

		attempt += 1
	}

	if fs.exists(path) { fs.remove_dir_all(path) else |_| {} }

	Cloned.GaveUp
}