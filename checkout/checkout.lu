//! One repository's directory on disk: what state it is in, and how to
//! bring it up to date

use git
use std.fs

/// what is at a repository's path before anything is done to it.
pub enum State {
	/// Nothing is there.
	Absent,
	/// An empty directory: safe to remove and clone into.
	Empty,
	/// A directory with files in it that is not a git checkout.
	Foreign,
	/// It has a `.git` but git cannot read a commit from it.
	Broken,
	/// A checkout with staged or unstaged changes.
	Dirty,
	/// A checkout with nothing to lose.
	Clean,
}

/// What looking after a checkout's submodules came to.
pub enum Subs {
    /// The repository has none.
    None,
    /// Every submodule is already at the commit the repository records.
    Current,
    /// At least one was fetched or moved.
    Updated,
    /// git could not report on them, or the update failed or ran out of time.
    Failed,
}

/// Whether `git submodule status` output shows work to do: a line that
/// starts with `-` (never fetched) or `+` (at a different commit).
pub fn stale(status: str) -> bool {
    for line in status.lines() {
        if line.starts_with("-") || line.starts_with("+") { return true }
    }
    false
}

/// Bring the submodules of the checkout at `path` to the commits it
/// records. Does nothing, and runs nothing, when there is no `.gitmodules`.
pub fn submodules(path: str, limit_ms: int) -> Subs ! git.Failure {
    if !fs.exists("{path}/.gitmodules") { return Subs.None }
    let status = git.run(path, ["submodule", "status", "--recursive"], QUICK_MS)?
    if status.code != 0 { return Subs.Failed }
    if !stale(status.out) { return Subs.Current }
    let ran = git.run(
        path,
        ["submodule", "update", "--init", "--recursive"],
        limit_ms,
    ) else |e| match e {
        not_found => { return not_found },
        timeout => { git.Ran { code: 124, out: "" } },
        io => { return io },
    }
    if ran.code == 0 { Subs.Updated } else { Subs.Failed }
}

/// What a fast-forward pull did.
pub enum Pulled {
	/// The checkout already had everything.
	UpToDate,
	/// New commits arrived.
	Updated,
	/// The branch and its upstream have each moved, or there is no
	/// upstream: nothing was changed.
	Refused,
}

/// How a clone ended.
pub enum Cloned {
	/// A full clone.
	Full,
	/// A clone with history cut to the newest commit.
	Shallow,
	/// Every attempt failed or ran out of time. Nothing is left behind.
	GaveUp,
}

/// How long a quick local git command may take.
const QUICK_MS: int = 600000

/// Look at `path` and say which state it is in. Reads only.
pub fn inspect(path: str) -> State ! git.Failure {
	if !fs.exists(path) { return State.Absent }
	if !fs.exists("{path}/.git") {
		let names = fs.read_dir(path) else |_| { return State.Foreign }
		return if names.len == 0 { State.Empty } else { State.Foreign }
	}

	let head = git.run(path, ["rev-parse", "HEAD"], QUICK_MS)?	
	if head.code != 0 { return State.Broken }

	let unstaged = git.run(path, ["diff", "--quiet"], QUICK_MS)?
	let staged = git.run(path, ["diff", "--cached", "--quiet"], QUICK_MS)?
	if unstaged.code != 0 || staged.code != 0 { return State.Dirty }

	State.Clean
}

/// Fast-forward a clean checkout. Never merges and never rewrites.
pub fn pull(path: str, limit_ms: int) -> Pulled ! git.Failure {
	let before = git.run(path, ["rev-parse", "HEAD"], QUICK_MS)?
	let pulled = git.run(path, ["pull", "--ff-only"], limit_ms)?

	if pulled.code != 0 { return Pulled.Refused }

	let after = git.run(path, ["rev-parse", "HEAD"], QUICK_MS)?

	if before.out == after.out { Pulled.UpToDate } else { Pulled.Updated }
}

/// The arguments for clone attempt `attempt` of `of`: a full clone, and a 
/// shallow one on the last attempt.
pub fn clone_args(url: str, name: str, attempt: int, of: int) -> List[str] {
	var args = ["clone", "--quiet"]

	if attempt == of && of > 1 {
		(mut args).push("--depth")
		(mut args).push("1")
	}

	(mut args).push(url)
	(mut args).push(name)

	args
}

/// Clone `url` into `parent/name`, trying up to `tries` times. A failed
/// attempt's leftovers are removed before the next. A time limit reached
/// counts as a failed attempt, not as a failure of the whole clone.
pub fn clone(url: str, parent: str, name: str, tries: int, limit_ms: int) -> Cloned ! git.Failure {
	let path = "{parent}/{name}"

	var attempt = 1
	while attempt <= tries {
		if fs.exists(path) { fs.remove_dir_all(path) else |_| { return io } }
		let ran = git.run(
			parent,
			clone_args(url, name, attempt, tries),
			limit_ms,
		) else |e| match e {
			not_found => { return not_found },
			timeout => { git.Ran { code: 124, out: "" } },
			io => { return io },
		}

		if ran.code == 0 && fs.exists("{path}/.git") {
			return if attempt == tries && tries > 1 { Cloned.Shallow } else { Cloned.Full }
		}

		attempt += 1
	}

	if fs.exists(path) { fs.remove_dir_all(path) else |_| {} }

	Cloned.GaveUp
}
/// A checkout in an organization's directory that no listed repository
/// will use, and the URL it was cloned from.
pub struct Stray {
	dir: str,
	origin: str,
}

/// The checkouts in `parent` whose names are not in `taken`, each with the
/// URL of its `origin` remote. Reads only. A `parent` that does not exist
/// holds none.
pub fn strays(parent: str, taken: List[str]) -> List[Stray] ! git.Failure {
	let names = fs.read_dir(parent) else |_| { return List[Stray]() }
	var found = List[Stray]()
	for name in names {
		var listed = false
		for t in taken {
			if t == name { listed = true }
		}
		if listed || !fs.exists("{parent}/{name}/.git") { continue }
		let ran = git.run("{parent}/{name}", ["config", "--get", "remote.origin.url"], QUICK_MS)?
		if ran.code == 0 { (mut found).push(Stray { dir: name, origin: ran.out }) }
	}
	found
}

/// Whether `url` is a clone URL of `owner`'s repository `repo`, in any of
/// the forms a clone URL takes (`https://github.com/OWNER/REPO.git`,
/// `git@github-work:OWNER/REPO.git`, `file:///…/OWNER/REPO.git`), with or
/// without the `.git`. GitHub ignores case in names, and so does this.
pub fn names_repo(url: str, owner: str, repo: str) -> bool {
	let u = url.lower()
	let bare = if u.ends_with(".git") { u[0..u.len - 4] } else { u }
	let want = "{owner}/{repo}".lower()
	bare.ends_with("/" + want) || bare.ends_with(":" + want)
}

/// The directory among `strays` that holds a checkout of `owner`'s `repo`,
/// or `""` when none does.
pub fn elsewhere(strays: List[Stray], owner: str, repo: str) -> str {
	for s in strays {
		if names_repo(s.origin, owner, repo) { return s.dir }
	}
	""
}

