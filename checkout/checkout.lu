//! One repository's directory on disk: what state it is in, and how to
//! bring it up to date

use git
use report
use std.fs

/// what is at a repository's path before anything is done to it.
pub enum State {
	/// Nothing is there.
	Absent,
	/// An empty directory: safe to remove and clone into.
	Empty,
	/// A directory with files in it that is not a git checkout.
	Foreign,
	/// It has a `.git` but git cannot read a commit from it.
	Broken,
	/// git read its commit but could not say whether it has changes: a
	/// `diff --quiet` that exited with neither 0 (none) nor 1 (some).
	Unchecked,
	/// A checkout with staged or unstaged changes.
	Dirty,
	/// A checkout with nothing to lose.
	Clean,
}

/// What looking after a checkout's submodules came to.
pub enum Subs {
    /// The repository has none.
    None,
    /// Every submodule is already at the commit the repository records.
    Current,
    /// At least one was fetched or moved.
    Updated,
    /// git could not report on them, or the update failed.
    Failed,
    /// The update did not finish within its limit.
    TimedOut,
}

/// Whether `git submodule status` output shows work to do: a line that
/// starts with `-` (never fetched) or `+` (at a different commit).
pub fn stale(status: str) -> bool {
    for line in status.lines() {
        if line.starts_with("-") || line.starts_with("+") { return true }
    }
    false
}

/// Bring the submodules of the checkout at `path` to the commits it
/// records. Does nothing, and runs nothing, when there is no `.gitmodules`.
/// `who` is the repository's name in the lines that name each step.
pub fn submodules(who: str, path: str, limit_ms: int) -> Subs ! git.Failure {
    if !fs.exists("{path}/.gitmodules") { return Subs.None }
    let status = asked(who, path, ["submodule", "status", "--recursive"])?
    if status.code != 0 { return Subs.Failed }
    if !stale(status.out) { return Subs.Current }
    let update = ["submodule", "update", "--init", "--recursive"]
    let ran = git.step(who, said(update), true, path, update, limit_ms) else |e| match e {
        not_found => { return not_found },
        timeout => { return Subs.TimedOut },
        io => { return io },
    }
    if ran.code == 0 { Subs.Updated } else { Subs.Failed }
}

/// What a fast-forward pull did.
pub enum Pulled {
	/// The checkout already had everything.
	UpToDate,
	/// New commits arrived.
	Updated,
	/// The branch and its upstream have each moved, or there is no
	/// upstream: nothing was changed.
	Refused,
	/// The pull did not finish within its limit and was stopped.
	TimedOut,
}

/// How a clone ended.
pub enum Cloned {
	/// A full clone.
	Full,
	/// A clone with history cut to the newest commit.
	Shallow,
	/// Every attempt failed or ran out of time. Nothing is left behind.
	GaveUp,
}

/// How long a quick local git command may take.
const QUICK_MS: int = 600000

/// `limit_ms` in words, for a message.
pub fn in_words(limit_ms: int) -> str {
	if limit_ms % 60000 == 0 {
		let m = limit_ms / 60000
		return if m == 1 { "1 minute" } else { "{m} minutes" }
	}
	"{limit_ms / 1000} seconds"
}

/// `args` as one would type them: `pull --ff-only`.
pub fn said(args: List[str]) -> str {
	var words = ""
	for a in args { words = if words == "" { a } else { "{words} {a}" } }
	words
}

/// Ask git a quick local question in the checkout at `path`, naming it
/// first as `who`'s step. Its standard error is never shown. One that is
/// not answered within QUICK_MS ends the whole run; it is named here again,
/// with its checkout, so the run's last words are not the only ones.
fn asked(who: str, path: str, args: List[str]) -> git.Ran ! git.Failure {
	git.step(who, said(args), false, path, args, QUICK_MS) else |e| match e {
		not_found => { return not_found },
		timeout => {
			eprint("sync-repos: `git {said(args)}` in {path} did not finish in {in_words(QUICK_MS)}")
			return timeout
		},
		io => { return io },
	}
}

/// Look at `path` and say which state it is in. Reads only. `who` names
/// the repository in the lines that name each question.
pub fn inspect(who: str, path: str) -> State ! git.Failure {
	if !fs.exists(path) { return State.Absent }
	if !fs.exists("{path}/.git") {
		let names = fs.read_dir(path) else |_| { return State.Foreign }
		return if names.len == 0 { State.Empty } else { State.Foreign }
	}

	let head = asked(who, path, ["rev-parse", "HEAD"])?
	if head.code != 0 { return State.Broken }

	let unstaged = asked(who, path, ["diff", "--quiet"])?
	let staged = asked(who, path, ["diff", "--cached", "--quiet"])?
	if unstaged.code > 1 || unstaged.code < 0 || staged.code > 1 || staged.code < 0 {
		return State.Unchecked
	}
	if unstaged.code != 0 || staged.code != 0 { return State.Dirty }

	State.Clean
}

/// Fast-forward a clean checkout. Never merges and never rewrites.
pub fn pull(who: str, path: str, limit_ms: int) -> Pulled ! git.Failure {
	let before = asked(who, path, ["rev-parse", "HEAD"])?
	let pull = ["pull", "--ff-only"]
	let pulled = git.step(who, said(pull), true, path, pull, limit_ms) else |e| match e {
		not_found => { return not_found },
		timeout => { return Pulled.TimedOut },
		io => { return io },
	}

	if pulled.code != 0 { return Pulled.Refused }

	let after = asked(who, path, ["rev-parse", "HEAD"])?

	if before.out == after.out { Pulled.UpToDate } else { Pulled.Updated }
}

/// The arguments for clone attempt `attempt` of `of`: a full clone, and a 
/// shallow one on the last attempt. A `quiet` clone reports no progress.
pub fn clone_args(url: str, name: str, attempt: int, of: int, quiet: bool) -> List[str] {
	var args = ["clone"]
	if quiet { (mut args).push("--quiet") }

	if attempt == of && of > 1 {
		(mut args).push("--depth")
		(mut args).push("1")
	}

	(mut args).push(url)
	(mut args).push(name)

	args
}

/// How clone attempt `attempt` of `of` is named as a step: `clone`, and
/// from the second on which attempt it is, and that the last is shallow.
pub fn clone_step(attempt: int, of: int) -> str {
	if attempt == 1 { return "clone" }
	if attempt == of { return "clone --depth 1, attempt {attempt} of {of}" }
	"clone, attempt {attempt} of {of}"
}

/// Clone `url` into `parent/name`, trying up to `tries` times, naming each
/// attempt first as `who`'s step. A failed attempt's leftovers are removed
/// before the next. A time limit reached counts as a failed attempt, not as
/// a failure of the whole clone. The clone reports its progress when
/// someone is watching, and is quiet otherwise.
pub fn clone(
	who: str,
	url: str,
	parent: str,
	name: str,
	tries: int,
	limit_ms: int,
) -> Cloned ! git.Failure {
	let path = "{parent}/{name}"
	let quiet = !report.watched()

	var attempt = 1
	while attempt <= tries {
		if fs.exists(path) { fs.remove_dir_all(path) else |_| { return io } }
		let ran = git.step(
			who,
			clone_step(attempt, tries),
			true,
			parent,
			clone_args(url, name, attempt, tries, quiet),
			limit_ms,
		) else |e| match e {
			not_found => { return not_found },
			timeout => { git.Ran { code: 124, out: "" } },
			io => { return io },
		}

		if ran.code == 0 && fs.exists("{path}/.git") {
			return if attempt == tries && tries > 1 { Cloned.Shallow } else { Cloned.Full }
		}

		attempt += 1
	}

	if fs.exists(path) { fs.remove_dir_all(path) else |_| {} }

	Cloned.GaveUp
}
/// A checkout in an organization's directory that no listed repository
/// will use, and the URL it was cloned from.
pub struct Stray {
	dir: str,
	origin: str,
}

/// The checkouts in `parent` whose names are not in `taken`, each with the
/// URL of its `origin` remote. Reads only. A `parent` that does not exist
/// holds none.
pub fn strays(parent: str, taken: List[str]) -> List[Stray] ! git.Failure {
	let names = fs.read_dir(parent) else |_| { return List[Stray]() }
	var found = List[Stray]()
	for name in names {
		var listed = false
		for t in taken {
			if t == name { listed = true }
		}
		if listed || !fs.exists("{parent}/{name}/.git") { continue }
		let ran = asked(name, "{parent}/{name}", ["config", "--get", "remote.origin.url"])?
		if ran.code == 0 { (mut found).push(Stray { dir: name, origin: ran.out }) }
	}
	found
}

/// Whether `url` is a clone URL of `owner`'s repository `repo`, in any of
/// the forms a clone URL takes (`https://github.com/OWNER/REPO.git`,
/// `git@github-work:OWNER/REPO.git`, `file:///…/OWNER/REPO.git`), with or
/// without the `.git`. GitHub ignores case in names, and so does this.
pub fn names_repo(url: str, owner: str, repo: str) -> bool {
	let u = url.lower()
	let bare = if u.ends_with(".git") { u[0..u.len - 4] } else { u }
	let want = "{owner}/{repo}".lower()
	bare.ends_with("/" + want) || bare.ends_with(":" + want)
}

/// The directory among `strays` that holds a checkout of `owner`'s `repo`,
/// or `""` when none does.
pub fn elsewhere(strays: List[Stray], owner: str, repo: str) -> str {
	for s in strays {
		if names_repo(s.origin, owner, repo) { return s.dir }
	}
	""
}

