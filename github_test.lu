//! member: false
//! GitHub's repository list, read without a network.

use github
use http

fn listed(page: str) -> str {
    let names = github.names(page) else |e| match e {
        Malformed(why) => { return "refused: {why}" },
    }
    "{names}"
}

fn test_names_in_order() {
    let page = "[{{\"id\": 1, \"name\": \"alpha\", \"private\": false}}, {{\"name\": \"beta\"}}]"
    assert(listed(page) == "[alpha, beta]", listed(page))
}

fn test_an_empty_page() {
    assert(listed("[]") == "[]", listed("[]"))
}

fn test_an_error_document_is_refused() {
    let got = listed("{{\"message\": \"Not Found\"}}")
    assert(got == "refused: expected a list of repositories", got)
}

fn test_not_json_is_refused() {
    assert(listed("<html>").starts_with("refused: not JSON"), listed("<html>"))
}

fn test_a_repository_without_a_name() {
    assert(
        listed("[{{\"id\": 7}}]") == "refused: a repository has no name",
        listed("[{{\"id\": 7}}]"),
    )
}

/// A response with `status` and `body`, as a fake server would give it.
fn answer(status: int, body: str) -> http.Response {
    http.Response { status: status, headers: Map[str, str](), body: body.bytes() }
}

/// A page of `count` repositories named `PREFIX0`, `PREFIX1`, …
fn page_of(prefix: str, count: int) -> str {
    var text = "["
    var i = 0
    while i < count {
        if i > 0 { text = text + "," }
        text = text + "{{\"name\": \"{prefix}{i}\"}}"
        i += 1
    }
    text + "]"
}

fn outcome(fetch: fn(str, str, str, int) -> http.Response ! {Failed(str)}, token: str) -> str {
    let names = github.list_with(fetch, "acme", token) else |e| match e {
        Failed(why) => { return "failed: {why}" },
    }
    "{names.len}: {names}"
}

/// An organization with two repositories.
fn small_org(host: str, path: str, token: str, limit_ms: int) -> http.Response ! {Failed(str)} {
    if path.starts_with("/orgs/acme/repos?") { return answer(200, page_of("r", 2)) }
    answer(404, "")
}

fn test_one_short_page_is_the_whole_list() {
    assert(outcome(small_org, "") == "2: [r0, r1]", outcome(small_org, ""))
}

/// 203 repositories: two full pages and a short one.
fn big_org(host: str, path: str, token: str, limit_ms: int) -> http.Response ! {Failed(str)} {
    if path.contains("&page=1&") { return answer(200, page_of("a", 100)) }
    if path.contains("&page=2&") { return answer(200, page_of("b", 100)) }
    if path.contains("&page=3&") { return answer(200, page_of("c", 3)) }
    Failed("asked for a page past the end: {path}")
}

fn test_pages_are_followed_to_a_short_one() {
    let got = github.list_with(big_org, "acme", "") else |e| match e {
        Failed(why) => { assert(false, why); return },
    }
    assert(got.len == 203, "{got.len}")
    assert(got[0] == "a0" && got[100] == "b0" && got[202] == "c2", "{got[0]} {got[100]} {got[202]}")
}

/// A user, not an organization. Answers the owner's repositories only
/// when asked for `type=owner`; asked for `type=all` it includes a
/// repository that belongs to someone else, as GitHub does.
fn a_user(host: str, path: str, token: str, limit_ms: int) -> http.Response ! {Failed(str)} {
    if path.starts_with("/orgs/") { return answer(404, "") }
    if path.contains("type=owner") { return answer(200, page_of("mine", 1)) }
    answer(200, "[{{\"name\": \"mine0\"}}, {{\"name\": \"someone-elses\"}}]")
}

fn test_a_user_is_found_after_the_organization_404() {
    assert(outcome(a_user, "") == "1: [mine0]", outcome(a_user, ""))
}

/// A server that refuses everyone.
fn forbidden(host: str, path: str, token: str, limit_ms: int) -> http.Response ! {Failed(str)} {
    answer(403, "")
}

fn test_a_refusal_reads_differently_with_and_without_a_token() {
    assert(outcome(forbidden, "").contains("without a token"), outcome(forbidden, ""))
    assert(
        outcome(forbidden, "t0ken").contains("may lack access to acme"),
        outcome(forbidden, "t0ken"),
    )
    assert(!outcome(forbidden, "t0ken").contains("t0ken"), "the token is in the message")
}

/// No server at all.
fn unplugged(host: str, path: str, token: str, limit_ms: int) -> http.Response ! {Failed(str)} {
    Failed("cannot connect to {host}:443 (refused)")
}

fn test_a_network_failure_passes_through_unchanged() {
    let got = outcome(unplugged, "")
    assert(got == "failed: cannot connect to api.github.com:443 (refused)", got)
}

/// A server that answers 200 with something that is not a repository list.
fn confused(host: str, path: str, token: str, limit_ms: int) -> http.Response ! {Failed(str)} {
    answer(200, "{{\"message\": \"Moved\"}}")
}

fn test_a_wrong_document_names_the_account() {
    let got = outcome(confused, "")
    assert(
        got == "failed: GitHub's answer for acme cannot be read: expected a list of repositories",
        got,
    )
}

/// Two accounts' views of one organization: the token `tok-work` sees a
/// private repository, and anyone else sees only the public one.
fn two_views(host: str, path: str, token: str, limit_ms: int) -> http.Response ! {Failed(str)} {
    if !path.starts_with("/orgs/acme/repos?") { return answer(404, "") }
    if token == "tok-work" {
        return answer(200, "[{{\"name\": \"site\"}}, {{\"name\": \"payroll\"}}]")
    }
    answer(200, "[{{\"name\": \"site\"}}]")
}

fn test_what_is_listed_depends_on_whose_token_asks() {
    assert(outcome(two_views, "tok-work") == "2: [site, payroll]", outcome(two_views, "tok-work"))
    assert(outcome(two_views, "tok-alt") == "1: [site]", outcome(two_views, "tok-alt"))
    assert(outcome(two_views, "") == "1: [site]", outcome(two_views, ""))
}

fn test_a_message_is_tamed_before_it_is_printed() {
    assert(github.tame("plain words", "") == "plain words", github.tame("plain words", ""))
    let dressed = github.tame("  red\x1b[31m alert\r\nsecond line\t", "")
    assert(dressed == "red [31m alert  second line", dressed)
    let leaked = github.tame("no such token: t0ken, try again", "t0ken")
    assert(leaked == "no such token: [token], try again", leaked)
}

fn test_a_long_message_is_cut() {
    var long = ""
    var i = 0
    while i < 40 {
        long = long + "0123456789"
        i += 1
    }
    let cut = github.tame(long, "")
    assert(cut.chars().len == 301 && cut.ends_with("…"), "{cut.chars().len} characters")
}

fn test_githubs_own_message_is_read_from_an_error_body() {
    let body = "{{\"message\": \"Bad credentials\", \"status\": \"401\"}}"
    assert(github.said(body.bytes(), "") == "Bad credentials", github.said(body.bytes(), ""))
    assert(github.said("<html>".bytes(), "") == "", github.said("<html>".bytes(), ""))
    assert(github.said("[]".bytes(), "") == "", github.said("[]".bytes(), ""))
    assert(github.said("{{\"message\": 7}}".bytes(), "") == "", "a number is not a message")
}

/// An organization that forbids the token it is shown, and says why.
fn strict_org(host: str, path: str, token: str, limit_ms: int) -> http.Response ! {Failed(str)} {
    var body = "{{\"message\": \"`acme` forbids access via a fine-grained personal access "
    body = body + "tokens if the token's lifetime is greater than 366 days.\", "
    body = body + "\"documentation_url\": \"https://docs.github.com/\", \"status\": \"403\"}}"
    answer(403, body)
}

fn test_a_refusal_carries_githubs_own_words() {
    let got = outcome(strict_org, "t0ken")
    let want = "failed: GitHub answered 403: `acme` forbids access via a fine-grained " +
        "personal access tokens if the token's lifetime is greater than 366 days."
    assert(got == want, got)
}

/// A server that repeats the token it was sent in its complaint.
fn parrot(host: str, path: str, token: str, limit_ms: int) -> http.Response ! {Failed(str)} {
    answer(401, "{{\"message\": \"Bad credentials: {token}\"}}")
}

fn test_a_token_echoed_by_the_server_is_not_printed() {
    let got = outcome(parrot, "t0ken")
    assert(got == "failed: GitHub answered 401: Bad credentials: [token]", got)
}

fn whose(fetch: fn(str, str, str, int) -> http.Response ! {Failed(str)}, token: str) -> str {
    github.login_with(fetch, token) else |e| match e {
        Failed(why) => "failed: {why}",
    }
}

/// GitHub as two tokens see it. `tok-mona` belongs to the user `Mona`, who
/// has a public and a private repository; `tok-acme` belongs to `hubot`.
/// Asked for `/users/mona/repos`, it shows the public one to anybody.
fn accounts(host: str, path: str, token: str, limit_ms: int) -> http.Response ! {Failed(str)} {
    if path == "/user" {
        if token == "tok-mona" { return answer(200, "{{\"login\": \"Mona\", \"id\": 1}}") }
        if token == "tok-acme" { return answer(200, "{{\"login\": \"hubot\", \"id\": 2}}") }
        return answer(401, "{{\"message\": \"Bad credentials\"}}")
    }
    if path.starts_with("/orgs/") { return answer(404, "{{\"message\": \"Not Found\"}}") }
    if path.starts_with("/user/repos?") && path.contains("affiliation=owner") {
        if token == "tok-mona" {
            return answer(200, "[{{\"name\": \"dotfiles\"}}, {{\"name\": \"diary\"}}]")
        }
        return Failed("asked for {path} as someone who is not mona")
    }
    if path.starts_with("/users/mona/repos?") { return answer(200, "[{{\"name\": \"dotfiles\"}}]") }
    answer(404, "{{\"message\": \"Not Found\"}}")
}

fn mine(token: str) -> str {
    let names = github.list_with(accounts, "mona", token) else |e| match e {
        Failed(why) => { return "failed: {why}" },
    }
    "{names}"
}

fn test_a_token_can_be_asked_whose_it_is() {
    assert(whose(accounts, "tok-mona") == "Mona", whose(accounts, "tok-mona"))
    assert(whose(accounts, "tok-acme") == "hubot", whose(accounts, "tok-acme"))
}

fn test_a_token_github_does_not_know_is_refused_in_githubs_words() {
    let got = whose(accounts, "t0ken")
    assert(got == "failed: GitHub answered 401: Bad credentials", got)
}

fn test_an_answer_with_no_login_is_refused() {
    assert(
        whose(confused, "t0ken") == "failed: GitHub's answer names no account",
        whose(confused, "t0ken"),
    )
}

fn test_your_own_account_lists_its_private_repositories() {
    assert(mine("tok-mona") == "[dotfiles, diary]", mine("tok-mona"))
}

fn test_someone_elses_account_lists_only_what_is_public() {
    assert(mine("tok-acme") == "[dotfiles]", mine("tok-acme"))
    assert(mine("") == "[dotfiles]", mine(""))
}

fn test_a_bad_token_fails_the_listing_of_a_user() {
    assert(mine("t0ken") == "failed: GitHub answered 401: Bad credentials", mine("t0ken"))
}
