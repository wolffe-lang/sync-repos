//! Github's REST API, one question: which repositories does this account have?

use http
use std.fs
use std.json

/// How many repositories to ask for at a time: the API's maximum.
const PER_PAGE: int = 100

/// The API host: `$SYNC_REPOS_API`, else GitHub's.
fn host() -> str {
    let named = env_get("SYNC_REPOS_API") else ""
    if named == "" { "api.github.com" } else { named }
}

/// The names in one page of the API's repository list.
pub fn names(page: str) -> List[str] ! {Malformed(str)} {
	let doc = json.parse(page) else |e| { return Malformed("not JSON ({e})") }
	let items = json.as_arr(doc) else { return Malformed("expected a list of repositories") }
	var out = List[str]()

	for item in items {
		let field = json.get(item, "name") else { return Malformed("a repository has no name") }
		let name = json.as_str(field) else { return Malformed("a repository's name is not text") }
		(mut out).push(name)
	}

	out
}

/// The path of one page of `account`'s repositories. `kind` is `orgs`,
/// `users`, or `user` for the account the token itself belongs to. An
/// organization is asked for all of them; a user only for the ones they
/// own, because a user's "all" includes other people's repositories they
/// help with. Only the `user` form shows a personal account's private
/// repositories, and it names no account: the token says whose they are.
fn page_path(kind: str, account: str, page: int) -> str {
    if kind == "user" { return "/user/repos?per_page={PER_PAGE}&page={page}&affiliation=owner" }
    let which = if kind == "orgs" { "all" } else { "owner" }
    "/{kind}/{account}/repos?per_page={PER_PAGE}&page={page}&type={which}"
}

/// The longest message from GitHub this program will print, in characters.
const SAID_MAX: int = 300

/// Text from a server, made safe to print on a terminal: `secret` (when
/// there is one) is blanked wherever it appears, every control character
/// becomes a space, and anything past `SAID_MAX` characters is cut.
pub fn tame(text: str, secret: str) -> str {
    let hidden = if secret == "" { text } else { text.replace(secret, "[token]") }
    var out = ""
    var kept = 0
    for c in hidden.chars() {
        if kept == SAID_MAX {
            out = out + "…"
            break
        }
        let code = c as int
        out = out + if code < 32 || code == 127 { ' ' } else { c }
        kept += 1
    }
    out.trim()
}

/// What GitHub itself says went wrong: the `message` of an error body,
/// tamed. `""` when the body has none.
pub fn said(body: List[byte], secret: str) -> str {
    let text = str_from_utf8(body) else { return "" }
    let doc = json.parse(text) else |_| { return "" }
    let field = json.get(doc, "message") else { return "" }
    let message = json.as_str(field) else { return "" }
    tame(message, secret)
}

/// What a status other than 200 means, in words. `said` is GitHub's own
/// message, or `""`; when GitHub explained itself, its words are used.
fn explain(status: int, account: str, with_token: bool, said: str) -> str {
    if status == 404 { return "GitHub knows no organization or user called {account} (404)" }
    if said != "" { return "GitHub answered {status}: {said}" }
    match status {
        401 => "GitHub rejected the token (401); is it current?",
        403 => if with_token {
            "GitHub refused (403); the token may lack access to {account}, or the rate limit is spent"
        } else {
            "GitHub refused (403); without a token only 60 requests an hour are allowed"
        },
        _ => "GitHub answered {status} for {account}",
    }
}

/// The account `token` belongs to: its login name on GitHub.
pub fn login(token: str) -> str ! {Failed(str)} {
    login_with(http.get, token)
}

/// `login`, asking through `fetch` instead of the network.
pub fn login_with(
    fetch: fn(str, str, str, int) -> http.Response ! {Failed(str)},
    token: str,
) -> str ! {Failed(str)} {
    let response = fetch(host(), "/user", token, 30000)?
    if response.status != 200 {
        let words = said(response.body, token)
        if words != "" { return Failed("GitHub answered {response.status}: {words}") }
        return Failed("GitHub answered {response.status} when asked whose the token is")
    }
    let text = str_from_utf8(response.body) else { return Failed("GitHub's answer is not text") }
    let doc = json.parse(text) else |e| { return Failed("GitHub's answer is not JSON ({e})") }
    let field = json.get(doc, "login") else { return Failed("GitHub's answer names no account") }
    let name = json.as_str(field) else { return Failed("GitHub's answer names no account") }
    tame(name, token)
}

/// Every repository of `account`, which may be an organization or a user.
/// `token` may be empty; then only public repositories are listed.
pub fn list(account: str, token: str) -> List[str] ! {Failed(str)} {
	list_with(http.get, account, token)
}

/// `list`, asking through `fetch` instead of the network. `fetch` is given
/// a host, a path, a token and a time limit, as `http.get` is
pub fn list_with(
	fetch: fn(str, str, str, int) -> http.Response ! {Failed(str)},
	account: str,
	token: str,
) -> List[str] ! {Failed(str)} {
    var kind = "orgs"
    var all = List[str]()
    var page = 1
    loop {
        let response = fetch(host(), page_path(kind, account, page), token, 30000)?
        if response.status == 404 && kind == "orgs" && page == 1 {
            kind = "users"
            if token != "" && login_with(fetch, token)?.lower() == account.lower() { kind = "user" }
            continue
        }
        if response.status != 200 {
            let words = said(response.body, token)
            return Failed(explain(response.status, account, token != "", words))
        }
        let text = str_from_utf8(response.body) else {
            return Failed("GitHub's answer is not text")
        }
        let found = names(text) else |e| match e {
            Malformed(why) => {
                return Failed("GitHub's answer for {account} cannot be read: {why}")
            },
        }
        for name in found { (mut all).push(name) }
        if found.len < PER_PAGE { break }
        page += 1
    }
    all
}

/// The token in the file at `path`, or `""` when there is no such file.
/// A file that anyone but its owner can red is refused, unread.
pub fn token(path: str) -> str ! {Exposed(str)} {
	let info = fs.stat(path) else |_| { return "" }

	if info.mode % 64 != 0 {
		return Exposed("{path} can be ready by other users; run: chmod 600 {path}")
	}

	let text = fs.read_text(path) else |_| { return Exposed("{path} cannot be read as text") }
	let value = text.trim()

	if value.contains(" ") || value.contains("\n") {
		return Exposed("{path} should hold one token and nothing else")
	}

	value
}