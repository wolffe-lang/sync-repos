//! Running git: one child process at a time, with a time limit. A step is
//! named on standard output before it starts, and a slow one may write to
//! the terminal while it runs.

use report
use std.bytes
use std.fs
use std.env
use std.process

/// The ways a git command can fail to give an exit status.
pub error Failure = {not_found, timeout, io}

/// How one git command ended.
pub struct Ran {
	/// The exit status: 0 is success.
	code: int,
	/// What it wrote to standard output.
	out: str,
}

/// The program to run as git: `$SYNC_REPOS_GIT`, else `git`.
fn program() -> str {
	let named = env_get("SYNC_REPOS_GIT") else ""
	if named == "" { "git" } else { named }
}

/// Wait for `child` to end, looking every 20 ms, for at most `limit_ms`,
/// moving what it writes to `from` into `kept` as it goes. A child that
/// writes more than a pipe holds waits for room; it gets it here, while it
/// runs, not once it has ended (which it never would).
fn wait_within(
	take child: process.Child,
	mut from: fs.File,
	mut kept: List[byte],
	limit_ms: int,
) -> int ! {timeout, io} {
	var child = child
	let deadline = time_now_ms() + limit_ms

	loop {
		let moved = drain(mut from, mut kept)
		let change = process.poll()?
		if change.changed && change.child.slot == child.slot {
			drain(mut from, mut kept)
			return process.shell_code(change.status)
		}

		if time_now_ms() >= deadline {
			process.kill(mut child) else |_| {}
			process.wait(take child) else |_| { 0 }

			return timeout
		}

		if moved == 0 { time_sleep_ms(20) }
	}
}

/// Move every byte `from` holds now into `kept`, and say how many. `from`
/// does not wait: a read with nothing to give ends the drain, as does the
/// end of the pipe.
fn drain(mut from: fs.File, mut kept: List[byte]) -> int {
	var moved = 0
	loop {
		let piece = fs.read_chunk(mut from, 65536) else { break }
		for b in piece { (mut kept).push(b) }
		moved += piece.len
	}
	moved
}

/// Run `git ARGS` in directory `dir`, keeping what it prints, for at most
/// `limit_ms`. What it writes to standard error is dropped.
pub fn run(dir: str, args: List[str], limit_ms: int) -> Ran ! Failure {
	run_with(dir, args, limit_ms, false)
}

/// Name a step, then run it as `run` does. The line `WHO: WHAT…` is
/// printed before git starts, so a step that takes minutes is never
/// silent. A `loud` step's standard error is this program's own when that
/// is a terminal; a step that is not loud, or that nobody is watching,
/// has it dropped.
pub fn step(
	who: str,
	what: str,
	loud: bool,
	dir: str,
	args: List[str],
	limit_ms: int,
) -> Ran ! Failure {
	print(report.step(who, what, report.color_wanted()))
	run_with(dir, args, limit_ms, loud && report.watched())
}

/// Run `git ARGS` in `dir` for at most `limit_ms`, keeping what it prints.
/// With `errors_shown`, git keeps this program's standard error; without,
/// it gets `/dev/null`.
fn run_with(dir: str, args: List[str], limit_ms: int, errors_shown: bool) -> Ran ! Failure {
	let back = env.cwd()?
	env.set_cwd(dir) else |_| { return not_found }
	defer env.set_cwd(back) else |_| {}

	var command = process.command(program())

	for a in args { process.push_arg(mut command, a) } 

	var pipe = process.pipe()?
	fs.set_nonblock(mut pipe.read, true) else |_| { return io }
	var null = fs.open_mode("/dev/null", 2) else |_| { return io }

	process.set_stdin(mut command, null)
	process.set_stdout(mut command, pipe.write)
	if !errors_shown { process.set_stderr(mut command, null) }

	var child = process.start(command) else |e| match e{
		not_found => { return not_found },
		_ => { return io },
	}

	fs.close(take pipe.write) else |_| {}
	fs.close(take null) else |_| {}
	defer fs.close(take pipe.read) else |_| {}

	var kept = List[byte]()
	let code = wait_within(take child, mut pipe.read, mut kept, limit_ms)?
	let out = bytes.to_str(kept) else ""

	Ran { code: code, out: out.trim() }
}