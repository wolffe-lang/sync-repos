//! Running git: one child process at a time, with a time limit.

use std.fs
use std.env
use std.process

/// The ways a git command can fail to give an exit status.
pub error Failure = {not_found, timeout, io}

/// How one git command ended.
pub struct Ran {
	/// The exit status: 0 is success.
	code: int,
	/// What it wrote to standard output, at most a few lines.
	out: str,
}

/// The program to run as git: `$SYNC_REPOS_GIT`, else `git`.
fn program() -> str {
	let named = env_get("SYNC_REPOS_GIT") else ""
	if named == "" { "git" } else { named }
}

/// Wait for `child` to end, looking every 20 ms, for at most `limit_ms`.
fn wait_within(take child: process.Child, limit_ms: int) -> int ! {timeout, io} {
	var child = child
	let deadline = time_now_ms() + limit_ms

	loop {
		let change = process.poll()?
		if change.changed && change.child.slot == child.slot {
			return process.shell_code(change.status)
		}

		if time_now_ms() >= deadline {
			process.kill(mut child) else |_| {}
			process.wait(take child) else |_| { 0 }

			return timeout
		}

		time_sleep_ms(20)
	}
}

/// Run `git ARGS` in directory `dir`, keeping what it prints, for at most `limit_ms`.
pub fn run(dir: str, args: List[str], limit_ms: int) -> Ran ! Failure {
	let back = env.cwd()?
	env.set_cwd(dir) else |_| { return not_found }
	defer env.set_cwd(back) else |_| {}

	var command = process.command(program())

	for a in args { process.push_arg(mut command, a) } 

	var pipe = process.pipe()?
	var null = fs.open_mode("/dev/null", 2) else |_| return { io }

	process.set_stdin(mut command, null)
	process.set_stdout(mut command, pipe.write)
	process.set_stderr(mut command, null)

	var child = process.start(command) else |e| match e{
		not_found => { return not_found },
		_ => { return io },
	}

	fs.close(take pipe.write) else |_| {}
	fs.close(take null) else |_| {}
	defer fs.close(take pipe.read) else |_| {}

	let code = wait_within(take child, limit_ms)?
	var out = ""

	loop {
		let piece = fs.read(mut pipe.read, 4096) else { break }
		out = out + piece
	}

	Ran { code: code, out: out.trim() }
}