use std.fs
use conf
use paths
use git
use http
use checkout
use report



/// How long one clone attempt or one pull may take
const SLOW_MS: int = 300000

/// How many times a clone is tried.
const TRIES: int = 3

/// What one repository's turn amounted to.
enum Did {
	Cloned,
	Updated,
	/// Already up to date: counted nowhere.
	Nothing,
	Skipped,
	Failed,
}

/// Count one repository's result. `name` is kept only for a failure.
fn record(mut t: report.Tally, did: Did, name: str) {
	match did {
		Did.Cloned => { t.cloned += 1 },
		Did.Updated => { t.updated += 1 },
		Did.Nothing => {},
		Did.Skipped => { t.skipped += 1 },
		Did.Failed => {
			t.failed += 1
			(mut t.failures).push(name)
		}
	}
}

/// Where an organization's repositories are cloned from.
fn remote_of(org: str, repo: str) -> str {
	let base = env_get("SYNC_REPOS_REMOTE") else ""
	if base == "" { "https://github.com/{org}/{repo}.git" } else { "{base}/{org}/{repo}.git" }
}

/// Bring one repository up to date, or say why it was left alone.
fn sync_repo(org: str, repo: str, dir: str, color: bool) -> Did ! git.Failure {
	let path = "{dir}/{repo}"

	match checkout.inspect(path)? {
		checkout.State.Foreign => {
			print(report.warn("{repo} (exists but is not a git checkout, skipping)", color))
			Did.Skipped
		},
		checkout.State.Broken => {
			print(report.warn("{repo} (git cannot read it, skipping)", color))
			Did.Skipped
		},
		checkout.State.Dirty => {
			print(report.warn("{repo} (uncommitted changes, skipping)", color))
			Did.Skipped
		},
		checkout.State.Clean => match checkout.pull(path, SLOW_MS)? {
			checkout.Pulled.UpToDate => {
				print(report.good("{repo} (up to date)", color))
				Did.Nothing
			}, 
			checckout.Pulled.Updated => {
				print(report.good("{repo} (updated)", color))
				Did.Updated
			},
			checkout.Pulled.Refused => {
				print(report.warn("{repo} (cannot fast-forward, skipping)", color))
				Did.Skipped
			},
		},
		checkout.State.Absent | checkout.State.Empty => {
			print(report.info("cloning {repo}...", color))

			match checkout.clone(remote_of(org, repo), dir, repo, TRIES, SLOW_MS)? {
				checkout.Cloned.Full => {
					print(report.good("{repo} (cloned)", color))
					Did.Cloned
				},
				checkout.Cloned.Shallow => {
					print(report.good("{repo} (cloned shallow)", color))
					Did.Cloned
				},
				checkout.Cloned.GaveUp => {
					print(report.bad("{repo} (clone failed after {TRIES} attempts)", color))
					Did.Failed
				},
			}
		}
	}
}

/// Sync every named repository of one organization.
fn sync_org(org: conf.Org, root: str, color: bool) -> report.Tally ! git.Failure {
	var tally = report.empty()
	let dir = "{root}/{org.local_dir}"

	print("")
	print("== {org.local_dir} <- {org.name}")

	if org.repos.len == 0 {
		print(
			report.warn(
				"no repositories named; listing an organization arrives in Part II",
				color,
			),
		)

		return tally
	}

	fs.create_dir_all(dir) else |_| { return io }

	for repo in org.repos {
		let did = region scratch {
			sync_repo(org.name, repo, dir, color)?
		}

		record(mut tally, did, "{org.name}/{repo}")
	}

	print("  {report.line(tally)}")
	tally
}

fn main() -> int {
	let where = paths.from_env() else {
		eprint(
			"sync-repos: HOME is not set; set it, or set both SYNC_REPOS_CONFIG and GITHUB_ORGS_DIR"
		)
		
		return 1
	}

	let text = fs.read_text(where.config) else |e| match e {
		not_found => {
			eprint("sync-repos: no config at {where.config}")
			eprint("  one line per organization, LOCAL_DIR=ORG; see orgs.conf.example")
			return 1
		},
		denied => {
			eprint("sync-repos: {where.config} permission denied")
			return 1
		},
		utf8 => {
			eprint("sync-repos: {where.config} is not UTF-8 text")
			return 1
		},
		io => {
			eprint("sync-repos: {where.config}: read error")
			return 1
		},
	}

	let orgs = conf.parse(text) else |e| match e {
		Malformed(why) => {
			eprint("sync-repos: {where.config}: {why}")
			return 1
		},
	}

	if orgs.len == 0 {
		eprint("sync-repos: {where.config} names no organizations")
		return 1
	}

	let page = http.get(
		"api.github.com",
		"/orgs/wolffe-lang/repos?per_page=3",
		"",
		30000,
	) else |e| match e {
		Failed(why) => {
			eprint("sync-repos: {why}")
			return 1
		},
	}

	let kind = page.headers["content-type"] else "(none)"
	print("GET /orgs/wolffe-lang/repos: {page.status}, {kind}, {page.body.len} bytes")
	
	let color = report.color_wanted()
	var total = report.empty()

	for org in orgs {
		let part = sync_org(org, where.root, color) else |e| match e {
			not_found => {
				eprint("sync-repos: cannot run git; is it installed and on PATH?")
				return 1
			}, 
			timeout => {
				eprint("sync-repos: git did not answer a local question in time")
				return 1
			},
			io => {
				eprint("sync-repos: cannot work in {where.root}/{org.local_dir}")
				return 1
			},
		}

		report.add(mut total, part)
	}

	print("")
	print("== done: {report.line(total)}")

	for name in total.failures {
		print("  failed: {name}")
	}
	
	if total.failed > 0 { 1 } else { 0 }
}