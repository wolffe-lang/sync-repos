use std.env
use std.fs
use conf
use paths
use git
use github
use identity
use options
use checkout
use report

/// How long one clone attempt or one pull may take
const SLOW_MS: int = 1800000

/// How many times a clone is tried.
const TRIES: int = 3

/// What one repository's turn amounted to.
enum Did {
	Cloned,
	Updated,
	/// Already up to date: counted nowhere.
	Nothing,
	Skipped,
	Failed,
}

/// Count one repository's result. `name` is kept only for a failure.
fn record(mut t: report.Tally, did: Did, name: str) {
	match did {
		Did.Cloned => { t.cloned += 1 },
		Did.Updated => { t.updated += 1 },
		Did.Nothing => {},
		Did.Skipped => { t.skipped += 1 },
		Did.Failed => {
			t.failed += 1
			(mut t.failures).push(name)
		}
	}
}

/// Where an entry's repositories are cloned from: an explicit base when
/// one is set, else Github over the chosen protocol. Over SSH the host is
/// the entry's identity's, so the clone is made as that identity.
fn remote_of(org: conf.Org, repo: str, ssh: bool) -> str {
	let base = env_get("SYNC_REPOS_REMOTE") else ""
	if base != "" { return "{base}/{org.name}/{repo}.git" }
	if ssh {
		"git@{identity.ssh_host(org.identity)}:{org.name}/{repo}.git"
	} else {
		"https://github.com/{org.name}/{repo}.git"
	}
}

/// say what a real run would do with a repository in `state`, and which
/// count that would add to. Changes nothing.
fn preview(state: checkout.State, repo: str, url: str, color: bool) -> Did {
	match state {
		checkout.State.Foreign => {
			print(report.warn("{repo} (exists but is not a git checkout, would skip)", color))
			Did.Skipped
		},
		checkout.State.Broken => {
			print(report.warn("{repo} (git cannot read it, would skip)", color))
			Did.Skipped
		},
		checkout.State.Unchecked => {
			print(report.warn("{repo} (git could not check it for changes, would skip)", color))
			Did.Skipped
		},
		checkout.State.Dirty => {
			print(report.warn("{repo} (uncommitted changess, would skip)", color))
			Did.Skipped
		},
		checkout.State.Clean => {
			print(report.info("{repo} (would pull)", color))
			Did.Nothing
		},
		checkout.State.Absent | checkout.State.Empty => {
			print(report.info("{repo} (would clone {url})", color))
			Did.Cloned
		},
	}
}

/// Look after the submodules of a checkout that was just cloned or pulled, 
/// and say so when there was anything to do. A failed update is a warning:
/// the repository itself is in place. An update that ran past its limit
/// fails the repository: the answer is true then.
fn tend(path: str, repo: str, color: bool) -> bool ! git.Failure {
	match checkout.submodules(path, SLOW_MS)? {
		checkout.Subs.None | checkout.Subs.Current => {},
		checkout.Subs.Updated => { print(report.good("  {repo}: submodules updated", color)) },
		checkout.Subs.Failed => { print(report.warn("  {repo}: submodule update failed", color)) } ,
		checkout.Subs.TimedOut => {
			let limit = checkout.in_words(SLOW_MS)
			print(report.bad("  {repo}: git submodule update --init --recursive did not finish in {limit}", color))
			return true
		},
	}
	false
}

/// How a repository is named in what the program prints: its own name,
/// and after an arrow the name of its directory when the list gave it one.
fn label(repo: str, local: str) -> str {
	if local == repo { repo } else { "{repo} → {local}" }
}

/// Bring one repository up to date, print what happened, and say which
/// count it belongs to. Its directory is the one `conf.local_name` gives.
fn sync_repo(
	org: conf.Org, 
	repo: str, 
	dir: str, 
	strays: List[checkout.Stray],
	opts: options.Options,
	color: bool
) -> Did ! git.Failure {
	let local = conf.local_name(org, repo)
	let path = "{dir}/{local}"
	let url = remote_of(org, repo, opts.ssh)
	let shown = label(repo, local)
	let state = checkout.inspect(path)?
	let moved = match state {
		checkout.State.Absent | checkout.State.Empty => checkout.elsewhere(strays, org.name, repo),
		_ => "",
	}
	if moved != "" {
		let undo = if moved == repo { "remove the rename" } else { "list it as {repo}>{moved}" }
		print(
			report.warn(
				"{shown} (already checked out as {moved}; move it to {local}, or {undo})",
				color,
			),
		)
		return Did.Skipped
	}
	if opts.dry_run { return preview(state, shown, url, color) }

	match state {
		checkout.State.Foreign => {
			print(report.warn("{shown} (exists but is not a git checkout, skipping)", color))
			Did.Skipped
		},
		checkout.State.Broken => {
			print(report.warn("{shown} (git cannot read it, skipping)", color))
			Did.Skipped
		},
		checkout.State.Unchecked => {
			print(report.warn("{shown} (git could not check it for changes, skipping)", color))
			Did.Skipped
		},
		checkout.State.Dirty => {
			print(report.warn("{shown} (uncommitted changes, skipping)", color))
			Did.Skipped
		},
		checkout.State.Clean => match checkout.pull(path, SLOW_MS)? {
			checkout.Pulled.UpToDate => {
				print(report.good("{shown} (up to date)", color))
				if tend(path, shown, color)? { Did.Failed } else { Did.Nothing }
			}, 
			checkout.Pulled.Updated => {
				print(report.good("{shown} (updated)", color))
				if tend(path, shown, color)? { Did.Failed } else { Did.Updated }
			},
			checkout.Pulled.Refused => {
				print(report.warn("{shown} (cannot fast-forward, skipping)", color))
				Did.Skipped
			},
			checkout.Pulled.TimedOut => {
				let limit = checkout.in_words(SLOW_MS)
				print(report.bad("{shown} (git pull --ff-only did not finish in {limit})", color))
				Did.Failed
			},
		},
		checkout.State.Absent | checkout.State.Empty => {
			print(report.info("cloning {shown}...", color))

			match checkout.clone(url, dir, local, TRIES, SLOW_MS)? {
				checkout.Cloned.Full => {
					print(report.good("{shown} (cloned)", color))
					if tend(path, shown, color)? { Did.Failed } else { Did.Cloned }
				},
				checkout.Cloned.Shallow => {
					print(report.good("{shown} (cloned shallow)", color))
					if tend(path, shown, color)? { Did.Failed } else { Did.Cloned }
				},
				checkout.Cloned.GaveUp => {
					print(report.bad("{shown} (clone failed after {TRIES} attempts)", color))
					Did.Failed
				},
			}
		}
	}
}

/// Sync every named repository of one organization.
fn sync_org(
	org: conf.Org, 
	repos: List[str],
	root: str, 
	opts: options.Options,
	color: bool
) -> report.Tally ! git.Failure {
	var tally = report.empty()
	let dir = "{root}/{org.local_dir}"

	if !opts.dry_run { fs.create_dir_all(dir) else |_| { return io } }

	var taken = List[str]()
	for repo in repos { (mut taken).push(conf.local_name(org, repo)) }
	let strays = checkout.strays(dir, taken)?

	for repo in repos {
		let did = region scratch {
			sync_repo(org, repo, dir, strays, opts, color)?
		}

		record(mut tally, did, "{org.name}/{repo}")
	}

	print("  {report.line(tally)}")
	tally
}

/// The line that opens an entry's part of the output. A named identity is
/// shown; the default one is not, so a config with no headers prints what
/// it always printed.
fn heading(org: conf.Org) -> str {
    if org.identity == conf.DEFAULT {
        "== {org.local_dir} <- {org.name}"
    } else {
        "== {org.local_dir} <- {org.name} [{org.identity}]"
    }
}

/// The repositories to sync for `org`: the ones the config names, or, when
/// it names none, every one GitHub lists.
fn repos_of(org: conf.Org, token: str, color: bool) -> List[str] ! {Failed(str)} {
    if org.repos.len > 0 { return copy org.repos }

    if token == "" && org.identity != conf.DEFAULT {
    	print(
    		report.warn("[{org.identity}] has no tokem; listing public repositories only", color),
    	)
    }
    
    print(report.info("asking GitHub for {org.name}'s repositories...", color))
    let names = github.list(org.name, token)?
    print(report.info("found {names.len}", color))
    names
}

/// Say who each identity is on GitHub and which entries it syncs, and
/// answer the exit status: 1 when a token was refused or could not be
/// checked, else 0. Syncs nothing.
fn who(
	orgs: List[conf.Org],
	tokens: Map[str, str],
	where: paths.Paths,
	ssh: bool,
	color: bool,
) -> int {
	var refused = 0
	for name in identity.used(orgs) {
		let file = paths.token_file(where, name)
		let token = tokens[name] else ""
		if token == "" {
			print(report.warn("[{name}] has no token at {file}: public repositories only", color))
		} else {
			let account = github.login(token) else |e| match e {
				Failed(why) => {
					refused += 1
					print(report.bad("[{name}] {why} (token: {file})", color))
					""
				},
			}
			if account != "" {
				print(report.good("[{name}] is {account} on GitHub (token: {file})", color))
			}
		}
		if ssh { print("    clones as git@{identity.ssh_host(name)}") }
		for org in orgs {
			if org.identity == name { print("    {org.local_dir} <- {org.name}") }
		}
	}
	if refused > 0 { 1 } else { 0 }
}

/// Whether `--only NAME` lets this entry through. No name lets all through.
fn chosen(org: conf.Org, only: str) -> bool {
	only == "" || org.local_dir == only || org.name == only
}

fn main() -> int {
	let opts = options.parse(env.args(), env_get("SYNC_REPOS_PROTOCOL") else "") else |e| match e {
		Usage(why) => {
			eprint("sync-repos: {why}")
			eprint(options.usage())

			return 2
		},
	}

	if opts.help {
		print(options.usage())
		return 0
	}

	let where = paths.from_env() else {
		eprint(
			"sync-repos: HOME is not set; set it, or set both SYNC_REPOS_CONFIG and GITHUB_ORGS_DIR"
		)
		
		return 1
	}

	let text = fs.read_text(where.config) else |e| match e {
		not_found => {
			eprint("sync-repos: no config at {where.config}")
			eprint("  one line per organization, LOCAL_DIR=ORG; see orgs.conf.example")
			return 1
		},
		denied => {
			eprint("sync-repos: {where.config} permission denied")
			return 1
		},
		utf8 => {
			eprint("sync-repos: {where.config} is not UTF-8 text")
			return 1
		},
		io => {
			eprint("sync-repos: {where.config}: read error")
			return 1
		},
	}

	let orgs = conf.parse(text) else |e| match e {
		Malformed(why) => {
			eprint("sync-repos: {where.config}: {why}")
			return 1
		},
	}

	if orgs.len == 0 {
		eprint("sync-repos: {where.config} names no organizations")
		return 1
	}

	var picked = List[conf.Org]()
	for org in orgs {
		if chosen(org, opts.only) { (mut picked).push(org) }
	}

	if picked.len == 0 {
		eprint("sync-repos: --only {opts.only}: no entry in {where.config} has that name")
		return 2
	}

	let tokens = identity.tokens(identity.used(picked), where) else |e| match e {
		Exposed(why) => {
			eprint("sync-repos: {why}")
			return 1
		},
	}
	
	let color = report.color_wanted()
	if opts.who { return who(picked, tokens, where, opts.ssh, color) }
	if opts.dry_run { print(report.info("dry run: nothing will be changed", color)) }
	var total = report.empty()

	for org in picked {
		print("")
		print(heading(org))
		let repos = repos_of(org, tokens[org.identity] else "", color) else |e| match e {
			Failed(why) => {
				print(report.bad("{org.name}: {why}", color))
				total.failed += 1
				(mut total.failures).push("{org.name} (listing)")

				continue
			},
		}

		let part = sync_org(org, repos, where.root, opts, color) else |e| match e {
			not_found => {
				eprint("sync-repos: cannot run git; is it installed and on PATH?")
				return 1
			}, 
			timeout => {
				eprint("sync-repos: git did not answer a local question in time")
				return 1
			},
			io => {
				eprint("sync-repos: cannot work in {where.root}/{org.local_dir}")
				return 1
			},
		}

		report.add(mut total, part)
	}

	print("")
	let ending = if opts.dry_run { "a real run would give" } else { "done" }
	print("== {ending}: {report.line(total)}")

	for name in total.failures {
		print("  failed: {name}")
	}
	
	if total.failed > 0 { 1 } else { 0 }
}