use std.env
use std.fs
use conf
use paths
use git
use github
use options
use checkout
use report

/// How long one clone attempt or one pull may take
const SLOW_MS: int = 300000

/// How many times a clone is tried.
const TRIES: int = 3

/// What one repository's turn amounted to.
enum Did {
	Cloned,
	Updated,
	/// Already up to date: counted nowhere.
	Nothing,
	Skipped,
	Failed,
}

/// Count one repository's result. `name` is kept only for a failure.
fn record(mut t: report.Tally, did: Did, name: str) {
	match did {
		Did.Cloned => { t.cloned += 1 },
		Did.Updated => { t.updated += 1 },
		Did.Nothing => {},
		Did.Skipped => { t.skipped += 1 },
		Did.Failed => {
			t.failed += 1
			(mut t.failures).push(name)
		}
	}
}

/// Where an organization's repositories are cloned from: an explicit base
/// when one is set, else Github over the chosen protocol.
fn remote_of(org: str, repo: str, ssh: bool) -> str {
	let base = env_get("SYNC_REPOS_REMOTE") else ""
	if base != "" { return "{base}/{org}/{repo}.git" }
	if ssh { "git@github.com:{org}/{repo}.git" } else { "https://github.com/{org}/{repo}.git"}
}

/// say what a real run would do with a repository in `state`, and which
/// count that would add to. Changes nothing.
fn preview(state: checkout.State, repo: str, url: str, color: bool) -> Did {
	match state {
		checkout.State.Foreign => {
			print(report.warn("{repo} (exists but is not a git checkout, would skip)", color))
			Did.Skipped
		},
		checkout.State.Broken => {
			print(report.warn("{repo} (git cannot read it, would skip)", color))
			Did.Skipped
		},
		checkout.State.Dirty => {
			print(report.warn("{repo} (uncommitted changess, would skip)", color))
			Did.Skipped
		},
		checkout.State.Clean => {
			print(report.info("{repo} (would pull)", color))
			Did.Nothing
		},
		checkout.State.Absent | checkout.State.Empty => {
			print(report.info("{repo} (would clone {url})", color))
			Did.Cloned
		},
	}
}

/// Look after the submodules of a checkout that was just cloned or pulled, 
/// and say so when there was anything to do. A failure here is a warning:
/// the repository itself is in place.
fn tend(path: str, repo: str, color: bool) -> () ! git.Failure {
	match checkout.submodules(path, SLOW_MS)? {
		checkout.Subs.None | checkout.Subs.Current => {},
		checkout.Subs.Updated => { print(report.good("  {repo}: submodules updated", color)) },
		checkout.Subs.Failed => { print(report.warn("  {repo}: submodule update failed", color)) } ,
	}
}

/// Bring one repository up to date, or say why it was left alone.
fn sync_repo(
	org: str, 
	repo: str, 
	dir: str, 
	opts: options.Options,
	color: bool
) -> Did ! git.Failure {
	let path = "{dir}/{repo}"
	let url = remote_of(org, repo, opts.ssh)
	let state = checkout.inspect(path)?
	if opts.dry_run { return preview(state, repo, url, color) }

	match state {
		CHECKOUT.State.Foreign => {
			print(report.warn("{repo} (exists but is not a git checkout, skipping)", color))
			Did.Skipped
		},
		checkout.State.Broken => {
			print(report.warn("{repo} (git cannot read it, skipping)", color))
			Did.Skipped
		},
		checkout.State.Dirty => {
			print(report.warn("{repo} (uncommitted changes, skipping)", color))
			Did.Skipped
		},
		checkout.State.Clean => match checkout.pull(path, SLOW_MS)? {
			checkout.Pulled.UpToDate => {
				print(report.good("{repo} (up to date)", color))
				tend(path, repo, color)?
				Did.Nothing
			}, 
			checkout.Pulled.Updated => {
				print(report.good("{repo} (updated)", color))
				tend(path, repo, color)?
				Did.Updated
			},
			checkout.Pulled.Refused => {
				print(report.warn("{repo} (cannot fast-forward, skipping)", color))
				Did.Skipped
			},
		},
		checkout.State.Absent | checkout.State.Empty => {
			print(report.info("cloning {repo}...", color))

			match checkout.clone(url, dir, repo, TRIES, SLOW_MS)? {
				checkout.Cloned.Full => {
					print(report.good("{repo} (cloned)", color))
					tend(path, repo, color)?
					Did.Cloned
				},
				checkout.Cloned.Shallow => {
					print(report.good("{repo} (cloned shallow)", color))
					tend(path, repo, color)?
					Did.Cloned
				},
				checkout.Cloned.GaveUp => {
					print(report.bad("{repo} (clone failed after {TRIES} attempts)", color))
					Did.Failed
				},
			}
		}
	}
}

/// Sync every named repository of one organization.
fn sync_org(
	org: conf.Org, 
	repos: List[str],
	root: str, 
	opts: options.Options,
	color: bool
) -> report.Tally ! git.Failure {
	var tally = report.empty()
	let dir = "{root}/{org.local_dir}"

	if !opts.dry_run { fs.create_dir_all(dir) else |_| { return io } }

	for repo in repos {
		let did = region scratch {
			sync_repo(org.name, repo, dir, opts, color)?
		}

		record(mut tally, did, "{org.name}/{repo}")
	}

	print("  {report.line(tally)}")
	tally
}

/// The repositories to sync for `org`: the ones the config names, or, when
/// it names none, every one GitHub lists.
fn repos_of(org: conf.Org, token: str, color: bool) -> List[str] ! {Failed(str)} {
    if org.repos.len > 0 { return copy org.repos }
    print(report.info("asking GitHub for {org.name}'s repositories...", color))
    let names = github.list(org.name, token)?
    print(report.info("found {names.len}", color))
    names
}

/// Whether `--only NAME` lets this entry through. No name lets all through.
fn chosen(org: conf.Org, only: str) -> bool {
	only == "" || org.local_dir == only || org.name == only
}

fn main() -> int {
	let opts = options.parse(env.args(), env_get("SYNC_REPOS_PROTOCOL") else "") else |e| match e {
		Usage(why) => {
			eprint("sync-repos: {why}")
			eprint(options.usage())

			return 2
		},
	}

	if opts.help {
		print(options.usage())
		return 0
	}

	let where = paths.from_env() else {
		eprint(
			"sync-repos: HOME is not set; set it, or set both SYNC_REPOS_CONFIG and GITHUB_ORGS_DIR"
		)
		
		return 1
	}

	let text = fs.read_text(where.config) else |e| match e {
		not_found => {
			eprint("sync-repos: no config at {where.config}")
			eprint("  one line per organization, LOCAL_DIR=ORG; see orgs.conf.example")
			return 1
		},
		denied => {
			eprint("sync-repos: {where.config} permission denied")
			return 1
		},
		utf8 => {
			eprint("sync-repos: {where.config} is not UTF-8 text")
			return 1
		},
		io => {
			eprint("sync-repos: {where.config}: read error")
			return 1
		},
	}

	let orgs = conf.parse(text) else |e| match e {
		Malformed(why) => {
			eprint("sync-repos: {where.config}: {why}")
			return 1
		},
	}

	if orgs.len == 0 {
		eprint("sync-repos: {where.config} names no organizations")
		return 1
	}

	var matched = 0 
	for org in orgs {
		if chosen(org, opts.only) { matched += 1 }
	}

	if matched == 0 {
		eprint("sync-repos: --only {opts.only}: no entry in {where.config} has that name")
		return 2
	}

	let token = github.token(where.token) else |e| match e {
		Exposed(why) => {
			eprint("sync-repos: {why}")
			return 1
		},
	}
	
	let color = report.color_wanted()
	if opts.dry_run { print(report.info("dry run: nothing will be changed", color)) }
	var total = report.empty()

	for org in orgs {
		if !chosen(org, opts.only) { continue }
		
		print("")
		print("== {org.local_dir} <- {org.name}")
		let repos = repos_of(org, token, color) else |e| match e {
			Failed(why) => {
				print(report.bad("{org.name}: {why}", color))
				total.failed += 1
				(mut total.failures).push("{org.name} (listing)")

				continue
			},
		}

		let part = sync_org(org, repos, where.root, opts, color) else |e| match e {
			not_found => {
				eprint("sync-repos: cannot run git; is it installed and on PATH?")
				return 1
			}, 
			timeout => {
				eprint("sync-repos: git did not answer a local question in time")
				return 1
			},
			io => {
				eprint("sync-repos: cannot work in {where.root}/{org.local_dir}")
				return 1
			},
		}

		report.add(mut total, part)
	}

	print("")
	let ending = if opts.dry_run { "a real run would give" } else { "done" }
	print("== {ending}: {report.line(total)}")

	for name in total.failures {
		print("  failed: {name}")
	}
	
	if total.failed > 0 { 1 } else { 0 }
}