use std.fs
use conf
use paths
use git

fn main() -> int {
	let where = paths.from_env() else {
		eprint(
			"sync-repos: HOME is not set; set it, or set both SYNC_REPOS_CONFIG and GITHUB_ORGS_DIR"
		)
		
		return 1
	}

	let text = fs.read_text(where.config) else |e| match e {
		not_found => {
			eprint("sync-repos: no config at {where.config}")
			eprint("  one line per organization, LOCAL_DIR=ORG; see orgs.conf.example")
			return 1
		},
		denied => {
			eprint("sync-repos: {where.config} permission denied")
			return 1
		},
		utf8 => {
			eprint("sync-repos: {where.config} is not UTF-8 text")
			return 1
		},
		io => {
			eprint("sync-repos: {where.config}: read error")
			return 1
		},
	}

	let orgs = conf.parse(text) else |e| match e {
		Malformed(why) => {
			eprint("sync-repos: {where.config}: {why}")
			return 1
		},
	}

	if orgs.len == 0 {
		eprint("sync-repos: {where.config} names no organizations")
		return 1
	}

	let version = git.run(".", ["--version"], 5000) else |e| match e{
		not_found => {
			eprint("sync-repos: cannot run git; is it installed and on PATH?")
			return 1
		},
		timeout => {
			eprint("sync-repos: git --version did not answer in 5 seconds")
			return 1	
		},
		io => {
			eprint("sync-repos: could not start git")
			return 1
		}
	}

	print("using {version.out}")
	print("syncing into {where.root}")

	for org in orgs {
		if org.repos.len == 0 {
			print("{org.local_dir} <- {org.name}: every repository")
		} else {
			print("{org.local_dir} <- {org.name}: {org.repos.len} named")
			for repo in org.repos {
				print("  {repo}")
			}
		}
	}

	0
}