//! member: false
//! Which identities a config uses.

use conf
use identity

fn used(text: str) -> str {
    let orgs = conf.parse(text) else |e| match e {
        Malformed(why) => { return "refused: {why}" },
    }
    "{identity.used(orgs)}"
}

fn test_a_config_with_no_headers_uses_one_identity() {
    assert(used("a=b\nc=d\n") == "[default]", used("a=b\nc=d\n"))
}

fn test_each_identity_is_named_once_in_first_seen_order() {
    let text = "[work]\na=b\n[alt]\nc=d\n[work]\ne=f\n[default]\ng=h\n"
    assert(used(text) == "[work, alt, default]", used(text))
}

fn test_a_header_with_no_entries_is_not_used() {
    assert(used("a=b\n[work]\n") == "[default]", used("a=b\n[work]\n"))
}