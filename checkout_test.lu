//! member: false
//! The clone plan: which arguments each attempt gets.

use checkout

fn test_early_attempts_are_full_clones() {
	let args = checkout.clone_args("https://example.invalid/o/r.git", "r", 1, 3)
	assert("{args}" == "[clone, --quiet, https://example.invalid/o/r.git, r]", "{args}")
}

fn test_the_last_attempt_is_shallow() {
    let args = checkout.clone_args("u", "r", 3, 3)
    assert("{args}" == "[clone, --quiet, --depth, 1, u, r]", "{args}")
}

fn test_a_single_attempt_is_never_shallow() {
    let args = checkout.clone_args("u", "r", 1, 1)
    assert("{args}" == "[clone, --quiet, u, r]", "{args}")
}

fn test_a_current_submodule_is_not_stale() {
	assert(!checkout.stale(" 3f2a9c1 vendor/lib (v1.2)"), "a leading space means current")
	assert(!checkout.stale(""), "no submodules, nothing stale")
}

fn test_an_unfetched_or_moved_submodule_is_stale() {
	assert(checkout.stale("-3f2a9c1 vendor/lib"), "never fetched")
	assert(checkout.stale(" 3f2a9c1 vendor/a (v1)\n+77b0e2d vendor/b (v2-3-g77b0e2d)"), "moved")
}

fn test_every_form_of_clone_url_names_its_repository() {
	assert(checkout.names_repo("https://github.com/acme/alpha.git", "acme", "alpha"), "https")
	assert(checkout.names_repo("git@github-work:acme/alpha.git", "acme", "alpha"), "an alias")
	assert(checkout.names_repo("file:///srv/remote/acme/alpha.git", "acme", "alpha"), "file")
	assert(checkout.names_repo("https://github.com/Acme/Alpha", "acme", "alpha"), "case, no .git")
}

fn test_a_url_of_another_repository_does_not() {
	assert(!checkout.names_repo("https://github.com/acme/alpha2.git", "acme", "alpha"), "alpha2")
	assert(!checkout.names_repo("https://github.com/xacme/alpha.git", "acme", "alpha"), "xacme")
	assert(!checkout.names_repo("git@github.com:other/alpha.git", "acme", "alpha"), "other")
	assert(!checkout.names_repo("", "acme", "alpha"), "no origin")
}

fn test_a_checkout_is_found_under_another_name() {
	var strays = List[checkout.Stray]()
	(mut strays).push(checkout.Stray { dir: "notes", origin: "git@github.com:me/notes.git" })
	(mut strays).push(checkout.Stray { dir: "a", origin: "file:///r/acme/alpha.git" })
	assert(
		checkout.elsewhere(strays, "acme", "alpha") == "a",
		checkout.elsewhere(strays, "acme", "alpha"),
	)
	assert(
		checkout.elsewhere(strays, "acme", "beta") == "",
		checkout.elsewhere(strays, "acme", "beta"),
	)
}
