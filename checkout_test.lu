//! member: false
//! The clone plan: which arguments each attempt gets.

use checkout

fn test_early_attempts_are_full_clones() {
	let args = checkout.clone_args("https://example.invalid/o/r.git", "r", 1, 3)
	assert("{args}" == "[clone, --quiet, https://example.invalid/o/r.git, r]", "{args}")
}

fn test_the_last_attempt_is_shallow() {
    let args = checkout.clone_args("u", "r", 3, 3)
    assert("{args}" == "[clone, --quiet, --depth, 1, u, r]", "{args}")
}

fn test_a_single_attempt_is_never_shallow() {
    let args = checkout.clone_args("u", "r", 1, 1)
    assert("{args}" == "[clone, --quiet, u, r]", "{args}")
}
