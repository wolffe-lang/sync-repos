//! member: false
//! The config parser: text in, values out, refusals by line.

use conf

fn refusal(text: str) -> str {
	let orgs = conf.parse(text) else |e| match e {
		Malformed(why) => { return why },
	}

	"accepted {orgs.len} entries"
}

fn test_an_org_with_no_list() {
	let o = conf.parse_entry("wolffe-lang=wolffe-lang") else {
		assert(false, "refused")
		return
	}

	assert(o.local_dir == "wolffe-lang", "local_dir is {o.local_dir}")
	assert(o.name == "wolffe-lang", "name is {o.name}")
	assert(o.repos.len == 0, "{o.repos.len} repos")
}

fn test_a_list_of_repos() {
	let o = conf.parse_entry("mine = someone : dotfiles, notes") else {
		assert(false, "refused")
		return
	}

	assert(o.local_dir == "mine", "local_dir is {o.local_dir}")
	assert(o.name == "someone", "name is {o.name}")
	assert(o.repos.len == 2, "{o.repos.len} repos")
	assert(o.repos[0] == "dotfiles" && o.repos[1] == "notes", "repos are {o.repos}")
}

fn test_comments_and_blanks_are_skipped() {
	let orgs = conf.parse("# mine\n\n  a=b\n\t# indented comment\nc=d:e\n") else {
		assert(false, "refused")
		return
	}

	assert(orgs.len == 2, "{orgs.len} entries")
	assert(orgs[1].repos.len == 1, "{orgs[1].repos.len} repos")
}

fn test_refusals_name_the_line() {
	assert(
		refusal("a=b\nnonsense\n") == "line 2: no `=`; an entry is LOCAL_DIR=ORG",
		refusal("a=b\nnonense\n"),
	)
	assert(refusal("=b") == "line 1: the local directory is empty", refusal("=b"))
	assert(refusal("a=") == "line 1: the organization is empty", refusal("a="))
	assert(refusal("a=b:c,,d") == "line 1: the repository name is empty", refusal("a=b:c,,d"))
	assert(
		refusal("../etc=b") == "line 1: the local directory `../etc` has a `/` in it",
		refusal("../etc=b"),
	)
	assert(refusal("..=b") == "line 1: the local directory cannot be `..`", refusal("..=b"))
}

fn test_a_trailing_colon_is_an_empty_name() {
	assert(refusal("a=b:") == "line 1: the repository name is empty", refusal("a=b:"))
}

/// Each entry of `text` as `LOCAL_DIR@IDENTITY`, in order.
fn identities(text: str) -> str {
    let orgs = conf.parse(text) else |e| match e {
        Malformed(why) => { return "refused: {why}" },
    }
    var out = ""
    for o in orgs {
        if out != "" { out = out + " " }
        out = out + "{o.local_dir}@{o.identity}"
    }
    out
}

fn test_entries_before_any_header_are_the_default_identity() {
    assert(identities("a=b\nc=d\n") == "a@default c@default", identities("a=b\nc=d\n"))
}

fn test_a_header_names_the_identity_of_what_follows() {
    let text = "a=b\n[work]\nc=d\ne=f:g\n\n# play\n[ alt ]\nh=i\n"
    assert(identities(text) == "a@default c@work e@work h@alt", identities(text))
}

fn test_a_default_header_goes_back() {
    let text = "[work]\na=b\n[default]\nc=d\n"
    assert(identities(text) == "a@work c@default", identities(text))
}

fn test_a_header_that_cannot_be_read_names_the_line() {
    assert(
        identities("a=b\n[work\n") ==
            "refused: line 2: a header is [NAME], with nothing after the `]`",
        identities("a=b\n[work\n"),
    )
    assert(identities("[]") == "refused: line 1: the identity is empty", identities("[]"))
    assert(
        identities("[a/b]") == "refused: line 1: the identity `a/b` has a `/` in it",
        identities("[a/b]"),
    )
    assert(
        identities("[my work]") == "refused: line 1: the identity `my work` has a space in it",
        identities("[my work]"),
    )
}

/// Each listed repository of a one-line config as `REPO@DIR`, or the refusal.
fn locals(text: str) -> str {
    let orgs = conf.parse(text) else |e| match e {
        Malformed(why) => { return "refused: {why}" },
    }
    var out = ""
    for repo in orgs[0].repos {
        if out != "" { out = out + " " }
        out = out + "{repo}@{conf.local_name(orgs[0], repo)}"
    }
    out
}

fn test_an_item_can_name_its_directory() {
    let got = locals("lab=acme:alpha>a, beta ,gamma > g\n")
    assert(got == "alpha@a beta@beta gamma@g", got)
}

fn test_a_config_without_renames_means_what_it_meant() {
    assert(locals("lab=acme:alpha,beta") == "alpha@alpha beta@beta", locals("lab=acme:alpha,beta"))
    assert(locals("lab=acme") == "", locals("lab=acme"))
}

fn test_a_rename_under_a_header_keeps_its_identity() {
    let orgs = conf.parse("[work]\nlab=acme:alpha>a\n") else {
        assert(false, "refused")
        return
    }
    assert(orgs[0].identity == "work", orgs[0].identity)
    assert(conf.local_name(orgs[0], "alpha") == "a", conf.local_name(orgs[0], "alpha"))
}

fn test_an_empty_side_is_refused() {
    assert(
        locals("x=y\nlab=acme:alpha>") == "refused: line 2: the local name for `alpha` is empty",
        locals("x=y\nlab=acme:alpha>"),
    )
    assert(
        locals("lab=acme:>a") == "refused: line 1: the repository name is empty",
        locals("lab=acme:>a"),
    )
}

fn test_a_second_arrow_is_refused() {
    assert(
        locals("lab=acme:alpha>a>b") == "refused: line 1: `alpha>a>b` has more than one `>`",
        locals("lab=acme:alpha>a>b"),
    )
}

fn test_a_local_name_is_one_plain_name() {
    assert(
        locals("lab=acme:alpha>x/y") == "refused: line 1: the local name `x/y` has a `/` in it",
        locals("lab=acme:alpha>x/y"),
    )
    assert(
        locals("lab=acme:alpha>..") == "refused: line 1: the local name `..` starts with `.`",
        locals("lab=acme:alpha>.."),
    )
    assert(
        locals("lab=acme:alpha>.a") == "refused: line 1: the local name `.a` starts with `.`",
        locals("lab=acme:alpha>.a"),
    )
    assert(
        locals("lab=acme:alpha>-n") == "refused: line 1: the local name `-n` starts with `-`",
        locals("lab=acme:alpha>-n"),
    )
}

fn test_two_repositories_cannot_share_a_directory() {
    assert(
        locals("lab=acme:alpha>a,beta>a") == "refused: line 1: the local name `a` is given twice",
        locals("lab=acme:alpha>a,beta>a"),
    )
    assert(
        locals("lab=acme:alpha>beta,beta>b") ==
            "refused: line 1: `alpha>beta`: `beta` is a repository in this list",
        locals("lab=acme:alpha>beta,beta>b"),
    )
}

fn test_a_repository_listed_twice_is_refused() {
    assert(
        locals("lab=acme:alpha,alpha>a") == "refused: line 1: `alpha` is listed twice",
        locals("lab=acme:alpha,alpha>a"),
    )
}
